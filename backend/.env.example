# =============================================================================
# TRAJECTORY — Environment Example (safe to commit)
# Copy to .env and fill in real values
# =============================================================================

PORT=3001
NODE_ENV=development
APP_NAME=Trajectory

ORACLE_USER=trajectory
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

REDIS_URL=redis://localhost:6379

JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars_here

FRONTEND_URL=http://localhost:5173

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ML_SERVICE_URL=http://localhost:8000

UPLOADS_DIR=uploads
