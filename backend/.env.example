# Trajectory API — copy to .env
PORT=3001
NODE_ENV=development

ORACLE_USER=trajectory
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Comma-separated allowed browser origins
FRONTEND_URL=http://localhost:5173

# Optional LLM for interview evaluation + resume suggestions: none | openai | ollama
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional ML inference service (python ml/serve.py). Rules are used when it is down.
ML_SERVICE_URL=http://localhost:8000

# Code execution
PYTHON_BIN=python
EXEC_MAX_CONCURRENCY=4

# Serve the built web app from the API (production)
# STATIC_DIR=../app/dist

# Optional: ensure an admin account exists at startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# 32-byte key for field-level encryption of resumes (required in production)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
