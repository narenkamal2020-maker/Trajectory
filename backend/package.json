{
  "name": "launchlane-backend",
  "version": "1.0.0",
  "description": "Trajectory API — Express + Oracle",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "ml:export": "tsx src/ml/export.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "downloads:publish": "node ../scripts/publish-downloads.js",
    "admin:create": "tsx src/db/create-admin.ts",
    "data:encrypt": "tsx src/db/encrypt-existing.ts",
    "db:grant": "tsx src/db/grant-app-user.ts",
    "db:backup": "tsx src/db/backup.ts",
    "db:restore": "tsx src/db/backup.ts restore"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "oracledb": "^7.0.1",
    "pdf-parse": "^2.4.5",
    "uuid": "^14.0.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^7.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^5.0.3"
  }
}
