# docker-compose settings (copy to .env). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORACLE_ADMIN_PASSWORD=change-me-admin
ORACLE_PASSWORD=change-me-app
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# AES-256 key for resume data (64 hex chars). Back it up separately — without it encrypted resumes are unreadable.
DATA_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3001
# none | openai | ollama
LLM_PROVIDER=none
OPENAI_API_KEY=
# Optional: create/ensure an admin account on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
